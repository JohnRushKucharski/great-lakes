.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data policy: raw/ inputs, code, and small template workbooks are committed.
# Regenerable analysis outputs (derived from raw/ via scripts) are NOT committed --
# keep them locally as insurance, regenerate via the batch/clean scripts if lost.
data/analysis/
# bulk/intermediate outputs of the data products (regenerate via each product's scripts);
# the docs-embedded figures and data/ products are tracked instead
data-products/*/outputs/
# analysis workflow outputs (regenerate via each workflow's scripts)
analyses/*/outputs/

# case studies: outputs are regenerable. Tracked: figures embedded in the memo, and the
# dashboard viewer files (small; browse results without re-running anything).
case-studies/*/*/outputs/*
!case-studies/long-tail-point/overtopping/outputs/figures/
!case-studies/long-tail-point/overtopping/outputs/dashboard.html
!case-studies/long-tail-point/overtopping/outputs/manifest.js
!case-studies/long-tail-point/habitat/outputs/figures/
!case-studies/long-tail-point/habitat/outputs/reliability/

# scratch space for ad hoc manual smoke tests, not part of the automated suite
manual_tests/

# Excel lock/temp files (left behind by opening a workbook, e.g. during manual checks)
~$*

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# AI tooling
skills/
