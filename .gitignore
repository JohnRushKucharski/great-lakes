.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data policy: raw/ inputs, code, and small template workbooks are committed.
# Regenerable analysis outputs (derived from raw/ via scripts) are NOT committed --
# keep them locally as insurance, regenerate via the batch/clean scripts if lost.
data/clean/
data/filled/
data/extrapolated/
data/analysis/

# longtailpoint: track input workbooks + dashboard.html/manifest.js viewer files
# (small, needed to browse results without re-running anything). Bulky generated
# batch outputs stay untracked/regenerable.
longtailpoint/*_output/
longtailpoint/results_*.xlsx
longtailpoint/~$*

# untracked working drafts, plans, and habitat-memo work in progress
docs/longtailpoint_memo_draft.md
docs/report_plan.md
longtailpoint/habitat/JK/
longtailpoint/habitat/JO/
longtailpoint/habitat/report/
longtailpoint/longtailpoint_memo.docx
longtailpoint/longtailpoint_memo_261030.docx
longtailpoint/MEMORANDUM.docx
src/great_lakes/build_memo_docx.py
src/great_lakes/longtailpoint_report.py
tests/test_build_memo_docx.py
tests/test_build_habitat_report.py
tests/test_longtailpoint_report.py

# scratch space for ad hoc manual smoke tests, not part of the automated suite
manual_tests/

# Excel lock/temp files (left behind by opening a workbook, e.g. during manual checks)
~$*

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# AI tooling
skills/
